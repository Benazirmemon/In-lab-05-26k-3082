#include <stdio.h>

int main()
{
    int cnic, test;

    printf("Do you have a CNIC? (1 = Yes, 0 = No): ");
    scanf("%d", &cnic);

    if (cnic == 1)
    {
        printf("Have you passed the driving test? (1 = Yes, 0 = No): ");
        scanf("%d", &test);

        if (test == 1)
        {
            printf("License Can Be Issued");
        }
        else
        {
            printf("License Cannot Be Issued: ");
        }
    }
    else
    {
        printf("License Cannot Be Issued: CNIC not available, driving test is not passed");
    }

    return 0;
}
